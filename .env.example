# ---------------------------------------------------------------------------
# Variables públicas (NEXT_PUBLIC_*) — se hornean en el bundle en build time.
# En Vercel: configúralas en Project Settings → Environment Variables y Vercel
# las inyecta en el build automáticamente. En local: cópialas a .env.local
# (o `vercel env pull .env.local`).
# ---------------------------------------------------------------------------

# Base URL pública del sitio (canonical, OpenGraph, sitemap, robots).
# Si se omite, usa https://sinergiastudiomkt.com
NEXT_PUBLIC_SITE_URL=

# Meta Pixel
NEXT_PUBLIC_META_PIXEL_ID=

# Google Ads (gtag.js)
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Label de conversión para el evento Lead (opcional, hoy sin usar)
NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=

# EmailJS (envío del formulario de contacto, client-side)
# OJO: si faltan, el formulario falla en silencio ("Missing environment variables").
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# ---------------------------------------------------------------------------
# Server-only (FUTURO — todavía no se usan en el código).
# NO llevan NEXT_PUBLIC_. Se leen en runtime dentro de la serverless function,
# nunca llegan al cliente.
# ---------------------------------------------------------------------------

# Meta Conversions API (CAPI)
# META_CAPI_ACCESS_TOKEN=
# META_PIXEL_ID=

# Resend (proveedor de correo)
# RESEND_API_KEY=
